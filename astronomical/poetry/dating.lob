#Tests

Sanity checks for the real terrain profile and its azimuth interpolation,
using Mytilene's own cached horizon data.

##azimuth wraps around the full circle
    _horizon_elevation(MYTILENE, 0.0) == _horizon_elevation(MYTILENE, 360.0)

##the horizon is never below the flat, sea-level baseline
    all(elevation >= 0.0 for elevation in _horizon_profile(MYTILENE))

##the sea to the east is a lower horizon than the hills to the west
    _horizon_elevation(MYTILENE, 90.0) < _horizon_elevation(MYTILENE, 270.0)

##interpolating exactly at a sampled azimuth matches the raw profile value
    _horizon_elevation(MYTILENE, 180.0) == _horizon_profile(MYTILENE).loc[180.0]


#References

    #Historical Date
    from functools import cache, lru_cache
    from pathlib import Path

    import numpy as np
    import pandas as pd
    from pvlib.iotools import get_pvgis_horizon
    from skyfield.api import Loader, Star, wgs84
    from skyfield.data import hipparcos
